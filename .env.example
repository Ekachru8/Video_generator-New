# ==============================================================================
# NOVAGEN STUDIO - AI VIDEO & CREATIVE PRODUCTION ENGINE
# ENVIRONMENT CONFIGURATION & REQUIRED API KEYS
# ==============================================================================
# Copy this file to .env and insert your API keys below.
# All APIs are optional: NovaGen Studio runs with intelligent local synthesis
# out of the box, and automatically connects to live APIs once keys are supplied.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI & IMAGEN 3 API (Recommended - Free Tier Available)
# ------------------------------------------------------------------------------
# Capabilities:
# - Viral Scriptwriting & Ideation (Gemini 3.8 Flash)
# - Intelligent Prompt Co-Pilot & Video Blueprints
# - 4K AI Image Generation (Imagen 3: imagen-3.0-generate-002)
# - High-Fidelity Text-to-Speech (Gemini TTS)
#
# Where to get it:
# 👉 https://aistudio.google.com/app/apikey (Instant free API key from Google AI Studio)
GEMINI_API_KEY="your_api_key_here"

# ------------------------------------------------------------------------------
# 2. REPLICATE API (Recommended for Universal Video & Image Generation)
# ------------------------------------------------------------------------------
# Capabilities:
# - Video Generation: Minimax Video-01, Wan 2.1 (wan-video/wan-2.1-t2v-14b),
#   CogVideoX-5B, Luma Ray, Stable Video Diffusion (SVD)
# - Image Generation: FLUX.1 [schnell] / [dev], SDXL Turbo
# - Low cost: ~$0.01 - $0.05 per video render (Pay per second of GPU usage)
#
# Where to get it:
# 👉 https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN="your_api_key_here"

# ------------------------------------------------------------------------------
# 3. FAL.AI API (Fastest Inference for Kling Video & FLUX Pro)
# ------------------------------------------------------------------------------
# Capabilities:
# - Direct Kling Video access (fal-ai/kling-video/v1.6/standard/text-to-video)
# - Minimax Video (fal-ai/minimax-video)
# - HunyuanVideo (fal-ai/hunyuan-video)
# - FLUX.1 Pro & Ultra
#
# Where to get it:
# 👉 https://fal.ai/dashboard/keys (Includes free starting credits)
FAL_KEY="your_api_key_here"

# ------------------------------------------------------------------------------
# 4. RUNWAYML API (Cinematic Hollywood Video Generator)
# ------------------------------------------------------------------------------
# Capabilities:
# - Runway Gen-3 Alpha & Gen-3 Alpha Turbo
# - Cinematic camera controls and motion brush
#
# Where to get it:
# 👉 https://runwayml.com/api or https://dev.runwayml.com/
RUNWAY_API_KEY="your_api_key_here"

# ------------------------------------------------------------------------------
# 5. ELEVENLABS API (Studio Voiceovers & AI Voice Cloning)
# ------------------------------------------------------------------------------
# Capabilities:
# - Ultra-realistic voice narration in 32+ languages
# - Emotional delivery and voice cloning
# - Generates 48kHz broadcast-quality WAV / MP3
#
# Where to get it:
# 👉 https://elevenlabs.io/ (Free plan includes 10,000 characters/month)
ELEVENLABS_API_KEY="your_api_key_here"

# ------------------------------------------------------------------------------
# 6. KLING AI OFFICIAL API (Native Kuaishou Video Engine)
# ------------------------------------------------------------------------------
# Capabilities:
# - Kling 3.0 / 1.6 native physics and motion fidelity
#
# Where to get it:
# 👉 https://klingai.com/
KLING_API_KEY="your_api_key_here"

# ------------------------------------------------------------------------------
# 7. SERVER HOSTING CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
